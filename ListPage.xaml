<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SalonBellissima.ListPage"
             Title="Lista Categoriilor ListPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adaugă Categorie" Clicked="OnAddCategorieClicked"/>
    </ContentPage.ToolbarItems>
    
    <VerticalStackLayout Padding="20">
        <Label Text="Lista Categoriilor" FontSize="24" HorizontalOptions="Center" />

        <ListView x:Name="categorieListView"
                  ItemSelected="OnCategorieSelected"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10">
                   
                            <Label Text="{Binding DenumireCategorie}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" />

                            <StackLayout Orientation="Horizontal" Padding="10">

                            <Button Text="Add" 
                                    Clicked="OnAddServiciuClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="Green"
                                    TextColor="White" />

                            <Button Text="Șterge" 
                                    Clicked="OnCategorieDelete" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="Red"
                                    TextColor="White" />
                        </StackLayout>

                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>