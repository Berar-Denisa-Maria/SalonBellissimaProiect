<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             x:Class="SalonBellissima.PaginaProgramare"
             Title="Pagina Programare">
    <VerticalStackLayout Padding="20">
        <Label Text="Selecteaza Serviciul" FontSize="24" HorizontalOptions="Center" />
        <Picker x:Name="serviciuPicker" Title="Alege un serviciu" Margin="10" />

        <Label Text="Selecteaza Data" FontSize="18" HorizontalOptions="Center" />
        <DatePicker x:Name="dataPicker" Margin="10" />

        <Label Text="Selecteaza Ora" FontSize="18" HorizontalOptions="Center" />
        <TimePicker x:Name="oraPicker" Margin="10" />

        <Button Text="Confirma Programarea" Clicked="OnConfirmareProgramareClicked" BackgroundColor="Green" TextColor="White" Margin="10" />

        <Label Text="Programarile existente" FontSize="24" HorizontalOptions="Center" Margin="20,30,20,10" />
        <ListView x:Name="programariListView" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding DataOra}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>
