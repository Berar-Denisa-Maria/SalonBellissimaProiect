<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SalonBellissima.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="logo.png"
                HeightRequest="150"
                Aspect="AspectFit"
                SemanticProperties.Description="Bine ati venit!" />

            <Label
                Text="Va rugam alegeti un serviciu!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Descoperă servicii ale noastre profesionale pentru frumusețea ta!"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                Text="Vezi Serviciile Noastre"
                Clicked="OnCategoriiButtonClicked"
                BackgroundColor="#EAB8C0"
                TextColor="White"
                CornerRadius="20"
                HorizontalOptions="Fill" />



        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
