<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SalonBellissima.MainPage"
             BackgroundColor="#f1eee9">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label 
                x:Name="notificareLabel" 
                FontSize="18" 
                TextColor="Brown" 
                HorizontalOptions="Center"/>    

            <Image
                Source="logo.png"
                HeightRequest="80"
                Aspect="AspectFit"
                SemanticProperties.Description="Bine ati venit!" />

            <Label
                Text="Descopera serviciile noastre profesionale pentru frumusetea ta!"
                FontSize="18"
                TextColor="#CD7F32"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                Text="Vezi Serviciile Noastre"
                Clicked="OnCategoriiButtonClicked"
                BackgroundColor="#CD7F32"
                TextColor="White"
                CornerRadius="15"
                WidthRequest="200"
                HeightRequest="40"
                HorizontalOptions="Center" />

            <Button 
                Text="Vezi Programari" 
                Clicked="OnNavigareProgramariClicked" 
                BackgroundColor="#CD7F32" 
                TextColor="White" 
                CornerRadius="15"
                WidthRequest="200"
                HeightRequest="40"
                HorizontalOptions="Center" />

            <Image
                Source="salon.jpeg"
                HeightRequest="80"
                Aspect="AspectFit"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
